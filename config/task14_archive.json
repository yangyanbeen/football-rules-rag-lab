{
  "version": "task14-spec-1.0",
  "baseline_commit": "5658f30ecaa714e2bdaca3085cc547414f478e36",
  "groups": {
    "corpus": {
      "experiment": "TASK-003",
      "sources": [
        "data/manifests/rag_dataset_manifest.json",
        "data/manifests/dense_chunk_ids.json"
      ],
      "parameters": [],
      "manifest": null,
      "commands": [
        "python -B scripts/validate_rag_dataset.py"
      ],
      "scope": "冻结中文语料规模；完整正文不公开；数据适配无质量推理"
    },
    "evaluation": {
      "experiment": "TASK-004-HUMAN-DELIVER",
      "sources": [
        "data/eval/dataset_manifest.json",
        "data/eval/retrieval_dev.jsonl",
        "data/eval/retrieval_test.jsonl",
        "data/eval/hard_negatives.jsonl",
        "data/eval/human_review_receipt.json"
      ],
      "parameters": [],
      "manifest": null,
      "commands": [
        "python -B scripts/validate_eval_receipt.py"
      ],
      "scope": "40开发/50测试，90条逐题人工核对标签；非裁判专家认证"
    },
    "dense": {
      "experiment": "TASK-007-DENSE-RETRIEVAL",
      "sources": [
        "reports/retrieval/dense_b0/test/summary.json",
        "reports/retrieval/dense_b0/test/predictions.jsonl",
        "reports/retrieval/dense_b0/test/run_manifest.json",
        "reports/retrieval/dense_b0/test_usage.jsonl"
      ],
      "parameters": [
        "config/dense_index.json",
        "config/dense_retrieval_b0.json"
      ],
      "manifest": "reports/retrieval/dense_b0/test/run_manifest.json",
      "commands": [
        "python -S -B scripts/task14_archive.py show --group dense"
      ],
      "scope": "固定99段Dense历史基线，测试40可回答/50总题，串行暖态，不能与不同候选预算直接计算因果增益"
    },
    "bm25": {
      "experiment": "TASK-008-BM25",
      "sources": [
        "reports/retrieval/bm25_b0/test/summary.json",
        "reports/retrieval/bm25_b0/test/predictions.jsonl",
        "reports/retrieval/bm25_b0/test/run_manifest.json",
        "reports/retrieval/bm25_b0/test_usage.jsonl"
      ],
      "parameters": [
        "config/bm25_b0.json",
        "config/bm25_dependency.json"
      ],
      "manifest": "reports/retrieval/bm25_b0/test/run_manifest.json",
      "commands": [
        "python -S -B scripts/task14_archive.py show --group bm25"
      ],
      "scope": "开发选title_body；CPU99段纯词法计时，不是端到端LLM延迟"
    },
    "hybrid": {
      "experiment": "TASK-009-HYBRID-RRF",
      "sources": [
        "reports/retrieval/hybrid_rrf_b0/test/summary.json",
