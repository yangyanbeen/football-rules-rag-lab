        "reports/retrieval/hybrid_rrf_b0/test_usage.jsonl"
      ],
      "parameters": [
        "config/hybrid_rrf.json"
      ],
      "manifest": "reports/retrieval/hybrid_rrf_b0/test/run_manifest.json",
      "commands": [
        "python -S -B scripts/task14_archive.py show --group hybrid"
      ],
      "scope": "双路各Top10的历史离线融合；不把通道与融合时间相加冒充真实端到端时钟"
    },
    "reranker": {
      "experiment": "TASK-010-BGE-RERANKER",
      "sources": [
        "reports/retrieval/bge_reranker_b0/test/summary.json",
        "reports/retrieval/bge_reranker_b0/test/predictions.jsonl",
        "reports/retrieval/bge_reranker_b0/test/run_manifest.json",
        "reports/retrieval/bge_reranker_b0/test_usage.jsonl"
      ],
      "parameters": [
        "config/reranker_experiment.json"
      ],
      "manifest": "reports/retrieval/bge_reranker_b0/test/run_manifest.json",
      "commands": [
        "python -S -B scripts/task14_archive.py show --group reranker"
      ],
      "scope": "同轮Dense/BM25各80、RRF60、四方法控制；开发选Top40，旧锁集已用，测试仅报告"
    },
    "structure": {
      "experiment": "TASK-011-STRUCTURE-PARENT-CHILD",
      "sources": [
        "reports/retrieval/structure_pc_b0/test/summary.json",
        "reports/retrieval/structure_pc_b0/test/predictions.jsonl",
        "reports/retrieval/structure_pc_b0/test/run_manifest.json",
        "reports/retrieval/structure_pc_b0/test_usage.jsonl",
        "data/manifests/structure_parent_child.json"
      ],
      "parameters": [
        "config/structure_parent_child.json"
      ],
      "manifest": "reports/retrieval/structure_pc_b0/test/run_manifest.json",
      "commands": [
        "python -S -B scripts/task14_archive.py show --group structure"
      ],
      "scope": "两组统一精确余弦，无重排；4096加性上下文预算；不能与Chroma基线混算收益"
    },
    "answers": {
      "experiment": "TASK-012-ANSWER-EVALUATION",
      "sources": [
        "reports/answer_evaluation/test/summary.json",
        "reports/answer_evaluation/test/predictions.jsonl",
        "reports/answer_evaluation/test/judgments.jsonl",
        "reports/answer_evaluation/test/run_started.json",
        "reports/answer_evaluation/test/environment.json",
        "reports/answer_evaluation/test_usage.jsonl"
      ],
      "parameters": [
        "config/answer_evaluation.json",
        "config/reranker_experiment.json"
      ],
      "manifest": "reports/answer_evaluation/test/run_started.json",
      "commands": [
        "python -S -B scripts/run_answer_evaluation.py replay"
      ],
      "scope": "同一小模型AI评分；不等于人工准确率，无B0答案对照，无改善结论"
    },
    "human": {
      "experiment": "TASK-012-HUMAN-ACCEPTANCE",
      "sources": [
        "reports/answer_evaluation_acceptance/human-quality-analysis.json",
        "reports/answer_evaluation_acceptance/human-review-completed.json"
      ],
      "parameters": [
        "config/citation_catalog_notes.json"
      ],
      "manifest": null,
      "commands": [
        "python -S -B scripts/task14_archive.py show --group human"
      ],
      "scope": "12题优先抽取错误的样本，AI先建议、用户本人提交；非盲审/非专家，不能外推50题"
    }
