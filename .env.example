# Example values only. This file is not loaded automatically.
# Set these environment variables in the terminal that starts Kotaemon.
# Local model names and adapters are saved in the application's model settings.
KH_OLLAMA_URL=http://127.0.0.1:11434/v1/
KH_GRADIO_SHARE=false
FOOTBALL_QUALITY_GUARD=1
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
# No real API key is needed for the local Ollama configuration.
